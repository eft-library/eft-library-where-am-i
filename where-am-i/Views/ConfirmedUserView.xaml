<Window x:Class="where_am_i.Views.ConfirmedUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EFT Library - 내 위치 찾기"
        Height="760" Width="720" MinHeight="480" MinWidth="520"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="StatusDetailStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Margin="24" Padding="24">
            <StackPanel>
                <Image Width="190" Height="54" Margin="0,0,0,16"
                       Source="https://image.eftlibrary.com/eftlibrary/tkl_main%2Flogo.png" Stretch="Uniform"/>
                <TextBlock Text="위치·레이드 감지" FontSize="22" FontWeight="Bold"/>
                <Grid Margin="0,12,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoringEnabled}" Value="False">
                                            <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding MonitoringStatusText}" FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding MonitoringButtonText}"
                            Command="{Binding ToggleMonitoringCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>

                <Border Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding RaidStatus}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RaidTimerStatus}" Style="{StaticResource StatusDetailStyle}"/>
                        <TextBlock Text="{Binding RaidTransmissionStatus}" Style="{StaticResource StatusDetailStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <TextBlock Text="스크린샷 위치" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding WatcherStatus}" Style="{StaticResource StatusDetailStyle}"/>
                        <TextBlock Text="{Binding ScreenshotTransmissionStatus}" Style="{StaticResource StatusDetailStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <TextBlock Text="로그 수집" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LogStatus}" Style="{StaticResource StatusDetailStyle}"/>
                        <Expander Header="감지 경로 보기" Margin="0,12,0,0"
                                  Foreground="{StaticResource SecondaryTextBrush}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="로그 실행 폴더" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding CurrentLogDirectory}" ToolTip="{Binding CurrentLogDirectory}"
                                           TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4,0,12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="스크린샷 감시 폴더" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding WatchingPaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ScreenshotPathReportStatus}" Style="{StaticResource StatusDetailStyle}"/>
                                <TextBlock Text="{Binding LogPathReportStatus}" Style="{StaticResource StatusDetailStyle}"/>
                                <TextBlock Text="직접 지정한 경로는 사용자 폴더명·이메일을 가려 자동 탐색 개선에 사용합니다. 감지 설정은 이 PC에서 복원합니다."
                                           Style="{StaticResource StatusDetailStyle}" Margin="0,8,0,8"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <TextBlock Text="앱 버전" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource StatusDetailStyle}"/>
                        <TextBlock Text="{Binding VersionCheckStatus}" Style="{StaticResource StatusDetailStyle}"/>
                        <TextBlock Text="{Binding LatestVersionText}" Style="{StaticResource StatusDetailStyle}"/>
                        <TextBlock Text="{Binding LastVersionCheckText}" Style="{StaticResource StatusDetailStyle}"/>
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding ReleaseNotes}" Style="{StaticResource StatusDetailStyle}"/>
                        </ScrollViewer>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="버전 다시 확인" Command="{Binding CheckVersionCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"/>
                            <Button Content="다운로드 페이지" Command="{Binding OpenUpdateDownloadCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="최근 활동 · 최대 100개" FontSize="14" FontWeight="SemiBold"/>
                            <CheckBox Grid.Column="1" Content="오류만" IsChecked="{Binding ShowOnlyErrors}"
                                      Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding LastActivity}" Style="{StaticResource StatusDetailStyle}" Margin="0,8,0,8"/>
                        <TextBlock Text="표시할 활동이 없습니다." FontSize="12" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVisibleActivities}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding ActivityView}" MaxHeight="240" Margin="0,4,0,0"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryTextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LocalTimeText}" FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ResultText}" FontSize="11" Margin="10,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,4,0,0">
                    <Button Content="감시 폴더 선택" Command="{Binding SelectFolderCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                    <Button Content="로그 폴더 선택" Command="{Binding SelectLogFolderCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                    <Button Content="현재 맵 열기" Command="{Binding OpenWebCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"/>
                    <Button Content="프로그램 종료" Command="{Binding ExitCommand}"
                            Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,8"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
