<Window x:Class="where_am_i.Views.ConfirmedUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="EFT Library"
        Height="800"
        Width="1240"
        MinHeight="680"
        MinWidth="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="16"
                Padding="18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="EFT Library"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="데스크톱 라이브 지도"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Text="지도"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Maps}"
                              SelectedItem="{Binding SelectedMap}"
                              DisplayMemberPath="DisplayName"
                              Padding="8"
                              Background="{StaticResource SurfaceRaisedBrush}"
                              Foreground="{StaticResource PrimaryTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="층"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Floors}"
                              SelectedItem="{Binding SelectedFloor}"
                              DisplayMemberPath="DisplayName"
                              Padding="8"
                              Background="{StaticResource SurfaceRaisedBrush}"
                              Foreground="{StaticResource PrimaryTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,1,8,0" Fill="#00D294"/>
                        <TextBlock Text="스크린샷 감시" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding WatcherStatus}"
                               Margin="0,7,0,14"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <Border Padding="10"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            CornerRadius="6">
                        <TextBlock Text="{Binding LastActivity}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="감지 중인 경로"
                               Margin="0,16,0,7"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding WatchingPaths}"
                             MaxHeight="150"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <Button Content="감시 폴더 선택"
                            Command="{Binding SelectFolderCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,0,8"/>
                    <Button Content="프로그램 종료"
                            Command="{Binding ExitCommand}"
                            Style="{StaticResource DangerButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="0,16,16,16"
                Background="#0B0E12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <Grid>
                <Viewbox x:Name="MapViewport"
                         Stretch="Uniform"
                         Margin="20"
                         RenderTransformOrigin="0.5,0.5"
                         MouseWheel="OnMapMouseWheel"
                         MouseLeftButtonDown="OnMapMouseLeftButtonDown"
                         MouseLeftButtonUp="OnMapMouseLeftButtonUp"
                         MouseMove="OnMapMouseMove">
                    <Canvas Width="{Binding MapWidth}"
                            Height="{Binding MapHeight}"
                            Background="#0B0E12">
                        <svgc:SvgViewbox Width="{Binding MapWidth}"
                                         Height="{Binding MapHeight}"
                                         Source="{Binding MapImage}"
                                         Stretch="Fill"/>

                        <Grid Width="24"
                              Height="24"
                              Canvas.Left="{Binding PlayerMarkerLeft}"
                              Canvas.Top="{Binding PlayerMarkerTop}"
                              Visibility="{Binding IsPlayerMarkerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="{Binding PlayerMarkerRotation}"/>
                            </Grid.RenderTransform>
                            <Ellipse Width="24" Height="24" Fill="#553B82F6"/>
                            <Polygon Points="12,1 18,18 12,14 6,18"
                                     Fill="#3B82F6"
                                     Stroke="White"
                                     StrokeThickness="1.5"/>
                        </Grid>
                    </Canvas>
                </Viewbox>

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="18"
                        Padding="12,8"
                        Background="#CC181C21"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedMap.DisplayName}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding MapStatus}"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18,12"
                        Background="#DD181C21"
                        CornerRadius="7"
                        Visibility="{Binding IsMapLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="지도 불러오는 중…"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
