<Window x:Class="where_am_i.Views.ConfirmedUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Title="EFT Library - 내 위치 찾기"
        Height="760" Width="720" MinHeight="480" MinWidth="520"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="StatusDetailStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>
    <ScrollViewer Background="{StaticResource AppBackgroundBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Margin="24" Padding="24">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Width="160" Height="46" HorizontalAlignment="Left"
                           Source="https://image.eftlibrary.com/eftlibrary/tkl_main%2Flogo.png" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="현재 맵 열기" Command="{Binding OpenWebCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" FontSize="12" Height="36" Padding="12,0" Margin="0,0,8,0"/>
                        <Button Content="프로그램 종료" Command="{Binding ExitCommand}"
                                Style="{StaticResource DangerButtonStyle}" FontSize="12" Height="36" Padding="12,0"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="위치·레이드 감지" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="앱 버전" Click="OpenAppVersion"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock Text="실행 중 자동 감지" Style="{StaticResource StatusDetailStyle}" Margin="0,8,0,16"/>

                <Border Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding RaidStatus}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RaidTimerStatus}" Style="{StaticResource StatusDetailStyle}"/>
                        <TextBlock Text="{Binding RaidTransmissionStatus}" Style="{StaticResource StatusDetailStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="스크린샷 위치" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="스크린샷 폴더 선택" Command="{Binding SelectFolderCommand}"
                                    Style="{StaticResource FolderButtonStyle}" Margin="12,0,0,0" FontSize="12" Height="36" Padding="14,0"/>
                        </Grid>
                        <TextBlock Text="{Binding WatcherStatus}" Style="{StaticResource StatusDetailStyle}"/>
                        <TextBlock Text="{Binding ScreenshotTransmissionStatus}" Style="{StaticResource StatusDetailStyle}"/>
                        <Expander Header="스크린샷 자동 정리" Margin="0,12,0,0" Foreground="{StaticResource SecondaryTextBrush}">
                            <StackPanel Margin="0,10,0,0">
                                <CheckBox Content="오래된 스크린샷 자동 정리" IsChecked="{Binding ScreenshotCleanupEnabled}"
                                          Foreground="{StaticResource PrimaryTextBrush}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="보관 기간" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                    <TextBox Text="{Binding ScreenshotRetentionDaysText, UpdateSourceTrigger=PropertyChanged}" Width="68"
                                             MaxLength="3" Padding="8,5" Margin="0,0,6,6" AutomationProperties.Name="스크린샷 보관 일수"/>
                                    <TextBlock Text="일 (1~365)" VerticalAlignment="Center" Margin="0,0,12,6"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding ScreenshotCleanupFolderText}" ToolTip="{Binding ScreenshotCleanupFolderText}"
                                           TextTrimming="CharacterEllipsis" Style="{StaticResource StatusDetailStyle}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="정리 폴더 선택" Command="{Binding SelectCleanupFolderCommand}"
                                            Style="{StaticResource FolderButtonStyle}" FontSize="12" Height="36" Padding="14,0" Margin="0,0,8,6"/>
                                    <Button Content="설정 적용" Command="{Binding ApplyCleanupSettingsCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12" Height="36" Padding="14,0" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <TextBlock Text="선택한 폴더의 게임 좌표 형식 PNG만 휴지통으로 이동합니다. 설정을 변경한 뒤 ‘설정 적용’을 눌러 주세요."
                                           Style="{StaticResource StatusDetailStyle}"/>
                                <TextBlock Text="{Binding ScreenshotCleanupStatus}" Style="{StaticResource StatusDetailStyle}"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="스크린샷 경로 보기" Margin="0,12,0,0"
                                  Foreground="{StaticResource SecondaryTextBrush}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="스크린샷 감시 폴더" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding WatchingPaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ScreenshotPathReportStatus}" Style="{StaticResource StatusDetailStyle}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="로그 수집" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="로그 폴더 선택" Command="{Binding SelectLogFolderCommand}"
                                    Style="{StaticResource FolderButtonStyle}" Margin="12,0,0,0" FontSize="12" Height="36" Padding="14,0"/>
                        </Grid>
                        <TextBlock Text="{Binding LogStatus}" Style="{StaticResource StatusDetailStyle}"/>
                        <Expander Header="로그 경로 보기" Margin="0,12,0,0"
                                  Foreground="{StaticResource SecondaryTextBrush}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="로그 실행 폴더" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding CurrentLogDirectory}" ToolTip="{Binding CurrentLogDirectory}"
                                           TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4,0,12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding LogPathReportStatus}" Style="{StaticResource StatusDetailStyle}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatusCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="최근 활동" FontSize="14" FontWeight="SemiBold"/>
                            <CheckBox Grid.Column="1" Content="오류만" IsChecked="{Binding ShowOnlyErrors}"
                                      Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding ActivityCountText}" Style="{StaticResource StatusDetailStyle}"/>
                        <TextBlock Text="{Binding LastActivity}" Style="{StaticResource StatusDetailStyle}" Margin="0,8,0,8"/>
                        <TextBlock Text="{Binding ActivityEmptyText}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVisibleActivities}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding VisibleActivities}" MaxHeight="240" Margin="0,4,0,0"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryTextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LocalTimeText}" FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ResultText}" FontSize="11" Margin="10,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
